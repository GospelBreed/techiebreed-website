# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables for production.

# Public address of the site, used for links, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://www.techiebreed.org

# Optional: overrides the Cal.com link in content/settings.json (shown on /contact#audit).
NEXT_PUBLIC_BOOKING_URL=

# Resend (https://resend.com) — sends the contact and Academy forms to your inbox.
RESEND_API_KEY=
# Where enquiries are delivered. Separate several addresses with commas.
CONTACT_TO_EMAIL=
# Sender shown on the enquiry emails. Must use a domain you have verified in Resend.
# Leave empty to use Resend's test sender (only delivers to your own Resend account email).
CONTACT_FROM_EMAIL="TechieBreed Website <hello@techiebreed.org>"

# Website connector for Claude (MCP) — see docs/WEBSITE_CONNECTOR.md
# Bearer token Claude signs in with (at least 24 random characters).
WEBSITE_MCP_TOKEN=
# Fine-grained GitHub token: this repository only, Contents read and write.
GITHUB_TOKEN=
GITHUB_REPO=GospelBreed/techiebreed-website
# Optional; defaults to main.
GITHUB_BRANCH=
