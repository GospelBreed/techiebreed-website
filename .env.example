# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables for production.

# Public address of the site, used for links, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://techiebreed.com

# Cal.com booking page shown on /contact#audit (free plan is fine).
# Example: https://cal.com/techiebreed/ai-operations-audit
NEXT_PUBLIC_BOOKING_URL=

# Resend (https://resend.com) — sends the contact and Academy forms to your inbox.
RESEND_API_KEY=
# Where enquiries are delivered. Separate several addresses with commas.
CONTACT_TO_EMAIL=
# Sender shown on the enquiry emails. Must use a domain you have verified in Resend.
# Leave empty to use Resend's test sender (only delivers to your own Resend account email).
CONTACT_FROM_EMAIL="TechieBreed Website <hello@techiebreed.com>"
